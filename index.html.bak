        let currentModalIndex = 0;
        let currentModalImages = [];

        // Initialize galleries
        function initializeGalleries() {
            Object.keys(imageData).forEach(galleryId => {
                const gallery = document.getElementById(galleryId);
                if (!gallery) return;

                const images = imageData[galleryId];
                images.forEach((image, index) => {
                    const item = document.createElement('div');
                    item.className = 'gallery-item';
                    // Use optimized image for gallery
                    const optimizedSrc = image.src.replace(/^/, 'optimized/');
                    item.innerHTML = `<img src="${optimizedSrc}" alt="${image.alt}" loading="lazy">`;
                    item.addEventListener('click', () => openModal(images, index));
                    gallery.appendChild(item);
                });
            });
        }

        // Modal functions
        function openModal(images, index) {
            currentModalImages = images;
            currentModalIndex = index;
            updateModalImage();
            document.getElementById('imageModal').classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            document.getElementById('imageModal').classList.remove('show');
            document.body.style.overflow = 'auto';
        }

        function updateModalImage() {
            const modal = document.getElementById('imageModal');
            const img = modal.querySelector('.modal-image');
            img.src = currentModalImages[currentModalIndex].src;
            img.alt = currentModalImages[currentModalIndex].alt;
        }

        function prevImage() {
            currentModalIndex = (currentModalIndex - 1 + currentModalImages.length) % currentModalImages.length;
            updateModalImage();
        }

        function nextImage() {
            currentModalIndex = (currentModalIndex + 1) % currentModalImages.length;
            updateModalImage();
        }

        // Event listeners
        document.querySelector('.modal-close').addEventListener('click', closeModal);
        document.querySelector('.modal-prev').addEventListener('click', prevImage);
        document.querySelector('.modal-next').addEventListener('click', nextImage);

        document.getElementById('imageModal').addEventListener('click', (e) => {
            if (e.target.id === 'imageModal') {
                closeModal();
            }
        });

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
            const modal = document.getElementById('imageModal');
            if (!modal.classList.contains('show')) return;

            if (e.key === 'ArrowLeft') prevImage();
            if (e.key === 'ArrowRight') nextImage();
            if (e.key === 'Escape') closeModal();
        });

        // Navigation menu
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();

                document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
                link.classList.add('active');

                document.querySelectorAll('.collection-section').forEach(section => {
                    section.classList.add('hidden');
                });

                const sectionId = link.dataset.section;
                const section = document.getElementById(sectionId);
                if (section) {
                    section.classList.remove('hidden');
                    section.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        // Header scroll collapse
        let lastScrollTop = 0;
        const header = document.querySelector('header');
        const body = document.body;
        const collapseThreshold = 100;

        window.addEventListener('scroll', () => {
            const scrollTop = window.scrollY;

            if (scrollTop > collapseThreshold) {
                // User is scrolled down
                if (scrollTop > lastScrollTop) {
                    // Scrolling down
                    header.classList.add('collapsed');
                    body.classList.add('header-collapsed');
                } else {
                    // Scrolling up
                    header.classList.remove('collapsed');
                    body.classList.remove('header-collapsed');
                }
            } else {
                // At top
                header.classList.remove('collapsed');
                body.classList.remove('header-collapsed');
            }

            lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        });

        // Initialize on load
        window.addEventListener('DOMContentLoaded', initializeGalleries);
    </script>
</body>
</html>
